# Application Environment Configuration
ENVIRONMENT=development
APP_NAME=Amrutam Telemedicine Backend
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Security & JWT (Production requires cryptographically strong secrets)
SECRET_KEY=dev-insecure-secret-key-must-be-changed-in-production-min32bytes!!
JWT_SECRET_KEY=dev-insecure-jwt-secret-key-must-be-changed-in-production-min32!!
JWT_ALGORITHM=HS256
JWT_KID=v1
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=Amrutam Telemedicine

# Database Connection (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/amrutam_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/amrutam_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=5

# Rate Limiting (Requests / minute)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_CONSULTATION_PER_MIN=20
RATE_LIMIT_GENERAL_PER_MIN=100

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Observability
PROMETHEUS_METRICS_ENABLED=true
OPENTELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
